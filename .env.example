# Copia este archivo como .env y completa los valores de tu máquina.
# Nunca subas el archivo .env al repositorio.

# Conexión a PostgreSQL (ver README, sección "Configurar la conexión a PostgreSQL").
# Si la contraseña tiene caracteres especiales (@ : / # ? %), escríbelos codificados.
DATABASE_URL="postgresql://servicios_hogar_user:<CONTRASEÑA_LOCAL>@localhost:5432/servicios_hogar_db"

# Clave para firmar los JWT: mínimo 32 caracteres, distinta en cada entorno.
# Genérala con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="<GENERAR_CLAVE_ALEATORIA>"

# Duración de los tokens: segundos (3600) o duración con unidad (15m, 1h, 7d).
JWT_EXPIRES_IN="1h"

# Puerto HTTP del backend (opcional, por defecto 3000).
# PORT=3000

# Orígenes del frontend autorizados por CORS, separados por coma
# (opcional, por defecto http://localhost:4200).
# CORS_ORIGIN=http://localhost:4200

# Carpeta privada para documentos subidos (opcional, por defecto storage/private).
# No puede estar dentro de src/, public/ ni dist/.
# FILE_STORAGE_DIR=storage/private

# Tamaño máximo de cada documento del trabajador, en MB (opcional, por defecto 5).
# WORKER_DOCUMENT_MAX_MB=5
