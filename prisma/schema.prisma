// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  CLIENTE
  TRABAJADOR
  ADMINISTRADOR
}

enum UserStatus {
  ACTIVO
  INACTIVO
  SUSPENDIDO
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  firstName    String     @map("first_name") @db.VarChar(100)
  lastName     String     @map("last_name") @db.VarChar(100)
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  phone        String?    @db.VarChar(20)
  status       UserStatus @default(ACTIVO)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles                UserRole[]                   @relation("UserRoles")
  assignedRoles        UserRole[]                   @relation("RoleAssignments")
  auditLogs            AdminAuditLog[]
  workerProfile        WorkerProfile?
  profileStatusChanges WorkerProfileStatusHistory[]
  zoneChangeDecisions  ZoneChangeRequest[]
  ordersAsClient       Order[]                      @relation("OrderClient")
  ordersAsWorker       Order[]                      @relation("OrderAssignedWorker")
  orderStatusChanges   OrderStatusHistory[]
  notifications        Notification[]

  @@index([status])
  @@map("users")
}

model UserRole {
  userId       String   @map("user_id") @db.Uuid
  role         RoleName
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  assignedById String?  @map("assigned_by_id") @db.Uuid

  user       User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("RoleAssignments", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, role])
  @@index([role])
  @@map("user_roles")
}

/// Catálogo de categorías de servicio (RF-48). Nunca se borra: se desactiva.
/// Los modelos que la referencien (perfiles, pedidos) deben usar onDelete: Restrict.
model ServiceCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.Citext
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workerSpecialties WorkerSpecialty[]
  orders            Order[]

  @@index([isActive])
  @@map("service_categories")
}

/// Catálogo de zonas de atención de Cochabamba (RF-49). Nunca se borra: se desactiva.
/// Los modelos que la referencien (perfiles, pedidos) deben usar onDelete: Restrict.
model Zone {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.Citext
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workerProfiles         WorkerProfile[]
  orders                 Order[]
  zoneChangeRequestsFrom ZoneChangeRequest[] @relation("ZoneChangeFrom")
  zoneChangeRequestsTo   ZoneChangeRequest[] @relation("ZoneChangeTo")

  @@index([isActive])
  @@map("zones")
}

/// Acciones de la bitacora. Las tres ultimas registran el acceso de un
/// administrador a los documentos privados de un trabajador (RF-56).
enum AuditAction {
  CREACION
  EDICION
  DESACTIVACION
  CAMBIO_ESTADO
  APROBACION
  RECHAZO
  CONSULTA_DOCUMENTOS
  VISUALIZACION_DOCUMENTO
  DESCARGA_DOCUMENTO
}

enum AuditEntityType {
  CATEGORIA_SERVICIO
  ZONA
  PERFIL_TRABAJADOR
  SOLICITUD_CAMBIO_ZONA
}

/// Bitácora de acciones administrativas (RF-53): quién, qué y cuándo.
/// Solo se inserta; la aplicación no expone edición ni borrado.
model AdminAuditLog {
  id         String          @id @default(uuid()) @db.Uuid
  actorId    String          @map("actor_id") @db.Uuid
  action     AuditAction
  entityType AuditEntityType @map("entity_type")
  entityId   String          @map("entity_id") @db.Uuid
  details    Json?
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

/// Estados del perfil (RF-08). BORRADOR: creado y aún no enviado a revisión.
enum WorkerProfileStatus {
  BORRADOR
  PENDIENTE
  OBSERVADO
  APROBADO
  RECHAZADO
  SUSPENDIDO
}

enum WeekDay {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

/// Tipos de documentación de respaldo (RF-07). Ninguno es obligatorio por ahora.
enum WorkerDocumentType {
  IDENTIDAD
  ANTECEDENTES
  CERTIFICADO
  REFERENCIA
}

/// CANCELADA: cierre automatico, no es una decision del administrador sobre la
/// solicitud (por ejemplo, al suspender el perfil). La causa queda en
/// ZoneChangeRequest.cancellationCause.
enum ZoneChangeRequestStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
  CANCELADA
}

/// Causa de una cancelacion automatica de solicitud de cambio de zona (T4.2).
enum ZoneChangeCancellationCause {
  SUSPENSION_PERFIL
}

/// Perfil del trabajador (RF-06). Nombre, correo y teléfono pertenecen a User.
/// La zona es fija (RF-13): tras el primer envío solo cambia por solicitud aprobada.
model WorkerProfile {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @unique @map("user_id") @db.Uuid
  yearsOfExperience Int                 @map("years_of_experience") @db.SmallInt
  description       String?             @db.VarChar(1000)
  zoneId            String              @map("zone_id") @db.Uuid
  status            WorkerProfileStatus @default(BORRADOR)
  submittedAt       DateTime?           @map("submitted_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user               User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  zone               Zone                         @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  specialties        WorkerSpecialty[]
  schedules          WorkerSchedule[]
  documents          WorkerDocument[]
  statusHistory      WorkerProfileStatusHistory[]
  zoneChangeRequests ZoneChangeRequest[]

  @@index([status, zoneId])
  @@index([zoneId])
  @@map("worker_profiles")
}

/// Especialidades del trabajador: categorías del catálogo (RF-48).
model WorkerSpecialty {
  profileId  String   @map("profile_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  profile  WorkerProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([profileId, categoryId])
  @@index([categoryId])
  @@map("worker_specialties")
}

/// Horario de atención semanal (no son reservas de trabajos). Minutos desde las 00:00.
model WorkerSchedule {
  id           String   @id @default(uuid()) @db.Uuid
  profileId    String   @map("profile_id") @db.Uuid
  dayOfWeek    WeekDay  @map("day_of_week")
  startMinutes Int      @map("start_minutes") @db.SmallInt
  endMinutes   Int      @map("end_minutes") @db.SmallInt
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile WorkerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, dayOfWeek])
  @@map("worker_schedules")
}

/// Documento de respaldo (RF-07). El archivo vive en un almacenamiento privado;
/// aquí solo se guardan sus metadatos. Un reemplazo conserva el anterior.
model WorkerDocument {
  id           String             @id @default(uuid()) @db.Uuid
  profileId    String             @map("profile_id") @db.Uuid
  type         WorkerDocumentType
  originalName String             @map("original_name") @db.VarChar(255)
  mimeType     String             @map("mime_type") @db.VarChar(100)
  sizeBytes    Int                @map("size_bytes")
  sha256       String             @db.Char(64)
  storageKey   String             @unique @map("storage_key") @db.VarChar(255)
  uploadedAt   DateTime           @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  replacedAt   DateTime?          @map("replaced_at") @db.Timestamptz(3)
  replacedById String?            @unique @map("replaced_by_id") @db.Uuid

  profile    WorkerProfile   @relation(fields: [profileId], references: [id], onDelete: Restrict)
  replacedBy WorkerDocument? @relation("DocumentReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   WorkerDocument? @relation("DocumentReplacement")

  @@index([profileId, type])
  @@map("worker_documents")
}

/// Historial de estados del perfil (RF-08). Solo inserción: un trigger impide editarlo o borrarlo.
model WorkerProfileStatusHistory {
  id          String               @id @default(uuid()) @db.Uuid
  profileId   String               @map("profile_id") @db.Uuid
  fromStatus  WorkerProfileStatus? @map("from_status")
  toStatus    WorkerProfileStatus  @map("to_status")
  changedById String               @map("changed_by_id") @db.Uuid
  reason      String?              @db.VarChar(1000)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  profile   WorkerProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  changedBy User          @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([profileId, createdAt])
  @@map("worker_profile_status_history")
}

/// Solicitud de cambio de zona (RF-13). Solo puede haber una PENDIENTE por perfil
/// (índice único parcial). El historial no se borra ni se reescribe: un trigger solo
/// permite resolver una solicitud PENDIENTE y un CHECK exige fecha y administrador
/// en las resueltas (migración 20261114000000_zone_change_requests_history_guard).
model ZoneChangeRequest {
  id                String                       @id @default(uuid()) @db.Uuid
  profileId         String                       @map("profile_id") @db.Uuid
  fromZoneId        String                       @map("from_zone_id") @db.Uuid
  toZoneId          String                       @map("to_zone_id") @db.Uuid
  reason            String                       @db.VarChar(500)
  status            ZoneChangeRequestStatus      @default(PENDIENTE)
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt         DateTime?                    @map("decided_at") @db.Timestamptz(3)
  decidedById       String?                      @map("decided_by_id") @db.Uuid
  decisionComment   String?                      @map("decision_comment") @db.VarChar(500)
  /// Solo en CANCELADA (CHECK en la BD). decidedBy y decidedAt indican quien
  /// provoco la cancelacion y cuando.
  cancellationCause ZoneChangeCancellationCause? @map("cancellation_cause")

  profile   WorkerProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  fromZone  Zone          @relation("ZoneChangeFrom", fields: [fromZoneId], references: [id], onDelete: Restrict)
  toZone    Zone          @relation("ZoneChangeTo", fields: [toZoneId], references: [id], onDelete: Restrict)
  decidedBy User?         @relation(fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([profileId, createdAt])
  @@index([status])
  @@map("zone_change_requests")
}

/// Estados de un pedido (§5.4). OrdersModule gestiona PUBLICADO, VENCIDO y
/// CANCELADO antes del acuerdo; el resto lo gestionaran ofertas, pagos,
/// visitas, agenda y reclamos mediante OrdersService.transition().
enum OrderStatus {
  PUBLICADO
  EN_NEGOCIACION
  ACORDADO
  ANTICIPO_REGISTRADO
  VISITA_REALIZADA
  PRESUPUESTO_ADICIONAL_PENDIENTE
  EN_EJECUCION
  TERMINADO
  EN_RECLAMO
  CERRADO
  SIN_ACUERDO
  VENCIDO
  CANCELADO
}

/// Quien hizo un cambio de estado: un usuario o un proceso automatico.
enum OrderActorType {
  USUARIO
  SISTEMA
}

/// Pedido del cliente (RF-14 a RF-18). La direccion exacta vive en OrderAddress.
model Order {
  id               String      @id @default(uuid()) @db.Uuid
  clientId         String      @map("client_id") @db.Uuid
  categoryId       String      @map("category_id") @db.Uuid
  zoneId           String      @map("zone_id") @db.Uuid
  description      String      @db.VarChar(2000)
  budgetAmount     Decimal     @map("budget_amount") @db.Decimal(10, 2)
  status           OrderStatus @default(PUBLICADO)
  revision         Int         @default(1)
  publishedAt      DateTime    @default(now()) @map("published_at") @db.Timestamptz(3)
  expiresAt        DateTime    @map("expires_at") @db.Timestamptz(3)
  lastEditedAt     DateTime?   @map("last_edited_at") @db.Timestamptz(3)
  assignedWorkerId String?     @map("assigned_worker_id") @db.Uuid
  cancelledAt      DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  client         User                 @relation("OrderClient", fields: [clientId], references: [id], onDelete: Restrict)
  category       ServiceCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  zone           Zone                 @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  assignedWorker User?                @relation("OrderAssignedWorker", fields: [assignedWorkerId], references: [id], onDelete: Restrict)
  address        OrderAddress?
  images         OrderImage[]
  statusHistory  OrderStatusHistory[]

  @@index([zoneId, categoryId, status, expiresAt])
  @@index([clientId, createdAt])
  @@index([status, expiresAt])
  @@index([clientId, categoryId, status])
  @@index([assignedWorkerId, status])
  @@map("orders")
}

/// Direccion exacta del trabajo: dato privado, separado del pedido para que
/// ninguna consulta de Order la incluya sin pedirla expresamente (RF-55).
model OrderAddress {
  orderId     String  @id @map("order_id") @db.Uuid
  addressLine String  @map("address_line") @db.VarChar(255)
  reference   String? @db.VarChar(255)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_addresses")
}

/// Fotografia procesada del pedido (WebP sin metadatos). Al eliminarla o
/// reemplazarla se borra la fila y sus archivos.
model OrderImage {
  id                 String   @id @default(uuid()) @db.Uuid
  orderId            String   @map("order_id") @db.Uuid
  position           Int      @db.SmallInt
  storageKey         String   @unique @map("storage_key") @db.VarChar(255)
  thumbnailKey       String   @unique @map("thumbnail_key") @db.VarChar(255)
  mimeType           String   @map("mime_type") @db.VarChar(50)
  width              Int
  height             Int
  sizeBytes          Int      @map("size_bytes")
  thumbnailSizeBytes Int      @map("thumbnail_size_bytes")
  sha256             String   @db.Char(64)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, position])
  @@map("order_images")
}

/// Historial de estados del pedido. Solo insercion (trigger). El actor es un
/// usuario (con el rol con que actuo) o un proceso del sistema.
model OrderStatusHistory {
  id            String         @id @default(uuid()) @db.Uuid
  orderId       String         @map("order_id") @db.Uuid
  fromStatus    OrderStatus?   @map("from_status")
  toStatus      OrderStatus    @map("to_status")
  actorType     OrderActorType @map("actor_type")
  changedById   String?        @map("changed_by_id") @db.Uuid
  actorRole     RoleName?      @map("actor_role")
  systemProcess String?        @map("system_process") @db.VarChar(50)
  reason        String?        @db.VarChar(500)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  order     Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

/// Cola compartida de archivos por borrar del almacenamiento privado
/// (StorageModule). La BD deja de apuntar al archivo y luego se borra; si el
/// borrado falla, se reintenta.
model PendingFileDeletion {
  id            String   @id @default(uuid()) @db.Uuid
  storageKey    String   @unique @map("storage_key") @db.VarChar(255)
  reason        String   @db.VarChar(50)
  attempts      Int      @default(0)
  lastError     String?  @map("last_error") @db.VarChar(500)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([nextAttemptAt])
  @@map("pending_file_deletions")
}

/// Tipos de notificacion interna (T3.2). Por ahora solo eventos de la
/// verificacion de perfiles de trabajador.
enum NotificationType {
  /// Para el trabajador: decision administrativa sobre su perfil.
  PERFIL_APROBADO
  PERFIL_OBSERVADO
  PERFIL_RECHAZADO
  PERFIL_SUSPENDIDO
  PERFIL_REACTIVADO
  /// Para los administradores: perfil enviado a verificacion.
  VERIFICACION_SOLICITADA
  VERIFICACION_REENVIADA_OBSERVACION
  VERIFICACION_REENVIADA_RECHAZO
  /// Para el trabajador: resultado de su solicitud de cambio de zona.
  SOLICITUD_ZONA_APROBADA
  SOLICITUD_ZONA_RECHAZADA
  SOLICITUD_ZONA_CANCELADA
}

/// Recurso al que apunta una notificacion (para navegar desde la interfaz).
enum NotificationResourceType {
  PERFIL_TRABAJADOR
  SOLICITUD_CAMBIO_ZONA
}

/// Notificacion interna de un usuario (v1.0 §6). Se conservan todas: no hay
/// borrado automatico. Solo cambia readAt al marcarla como leida.
model Notification {
  id           String                    @id @default(uuid()) @db.Uuid
  userId       String                    @map("user_id") @db.Uuid
  type         NotificationType
  title        String                    @db.VarChar(150)
  message      String                    @db.VarChar(2000)
  resourceType NotificationResourceType? @map("resource_type")
  resourceId   String?                   @map("resource_id") @db.Uuid
  readAt       DateTime?                 @map("read_at") @db.Timestamptz(3)
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Listado del usuario ordenado por fecha y conteo o filtro de no leidas.
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}
